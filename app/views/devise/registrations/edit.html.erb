<div class="container mt-5">
  <h2 class="text-center mb-4">会員情報編集</h2>

  <%= form_with model: @user, method: :patch, local: true do |f| %>
    <!-- バリデーションメッセージ-->  
    <% if resource.errors.any? %>
      <div class="error-messages">
        <h4><%= resource.errors.count %>件のエラーがあります</h4>
        <ul>
          <% resource.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
      <% end %>
    <!-- ユーザー名 -->
    <div class="mb-3 row">
      <label class="col-sm-2 col-form-label">ユーザー名</label>
      <div class="col-sm-10"><%= f.text_field :name, class: "form-control" %></div>
    </div>

    <!-- メールアドレス -->
    <div class="mb-3 row">
      <label class="col-sm-2 col-form-label">メールアドレス</label>
      <div class="col-sm-10"><%= f.email_field :email, class: "form-control" %></div>
    </div>

    <!-- 都道府県 --> 
    <div class="row mb-3">
      <div class="col-2 d-flex align-items-center">
        <label class="form-label mb-0">都道府県</label>
      </div>
      <div class="col-10">
        <%= f.collection_select :prefecture_id, Prefecture.all, :id, :name, prompt: "選択してください" %>
      </div>
    </div>

    <!-- 自己紹介文 -->
    <div class="mb-3 row">
      <label class="col-sm-2 col-form-label">自己紹介文</label>
      <div class="col-sm-10"><%= f.text_field :introduction, class: "form-control" %></div>
    </div>

    <div class="d-flex justify-content-center mt-4">
      <%= f.submit "編集内容を保存", class: "btn btn-success me-3" %>
      <%= link_to "退会する", unsubscribe_users_path, class: "btn btn-danger" %>
    </div>
  <% end %>
</div>