<div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh">
  <div class="card p-4 shadow-sm " style="width: 800px;" >
    <h4>新規ユーザー登録</h4>

    <%= form_for(resource, 
             as: resource_name, 
             url: registration_path(resource_name), 
             html: { data: { turbo: false } }) do |f| %>
      <!-- バリデーションエラーメッセージ-->
      <% if resource.errors.any? %>
        <div class="error-messages">
          <h4><%= resource.errors.count %>件のエラーがあります</h4>
          <ul>
            <% resource.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>  
      <!-- ユーザー名 -->
      <div class="row mb-3">
        <div class="col-2 d-flex align-items-center">
          <label class="form-label mb-0">ユーザー名</label>
        </div>
        <div class="col-10">
          <%= f.text_field :name, class: "form-control", placeholder: "park" %>
        </div>
      </div>

      <!-- メールアドレス -->
      <div class="row mb-3">
        <div class="col-2 d-flex align-items-center">
          <%= f.label :email, "メールアドレス", class: "form-label mb-0" %>
        </div>
        <div class="col-10">
          <%= f.email_field :email, class: "form-control", placeholder: "sample@example.com" %>
        </div>
      </div>

            <!-- パスワード -->
      <div class="row mb-3">
        <div class="col-2 d-flex align-items-center">
          <%= f.label :password, "パスワード(6文字以上)", class: "form-label mb-0" %>
        </div>
        <div class="col-10">
          <%= f.password_field :password, class: "form-control" %>
        </div>
      </div>

      <!-- パスワード確認 -->
      <div class="row mb-4">
        <div class="col-2 d-flex align-items-center">
          <%= f.label :password_confirmation, "パスワード(確認用)", class: "form-label mb-0" %>
        </div>
        <div class="col-10">
          <%= f.password_field :password_confirmation, class: "form-control" %>
        </div>
      </div>

      <!-- 都道府県 --> 
      <div class="row mb-3">
        <div class="col-2 d-flex align-items-center">
          <label class="form-label mb-0">都道府県</label>
        </div>
        <div class="col-10">
          <%= f.collection_select :prefecture_id, Prefecture.all, :id, :name, prompt: "選択してください" %>
        </div>
      </div>

      <!-- 自己紹介文 -->
      <div class="row mb-3">
        <div class="col-2 d-flex align-items-center">
          <%= f.label :introduction, "自己紹介文", class: "form-label mb-0" %>
        </div>
        <div class="col-10">
          <%= f.text_field :introduction, class: "form-control", placeholder: "自己紹介文はこちら" %>
        </div>
      </div>

      <!-- 登録ボタン -->
      <div class="text-center">
        <%= f.submit "新規登録", class: "btn btn-success px-5 py-2 fw-bold" %>
      </div>
    <% end %>
  
    <h4>既に登録済みの方</h4>
       <p><%= link_to "こちら", "/users/sign_in" %>からログインしてください。</p>
  </div>
</div>
