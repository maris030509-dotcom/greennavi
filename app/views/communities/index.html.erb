<div class="container my-5" style="max-width: 900px;">
  <div class="d-flex justify-content-between align-items-center flex-wrap mb-5">
    <h2 class="fw-bold fs-3 mb-0" style="color: #3B5339;">
      🌿 コミュニティ一覧 <span class="fs-6 text-muted fw-normal">（全<%= @communities.count %>件）</span>
    </h2>
    <%= link_to new_community_path, class: "btn btn-success rounded-pill px-4 shadow-sm" do %>
      <i class="fa-solid fa-plus me-1"></i> コミュニティ作成
    <% end %>
  </div>

  <!-- コミュニティ一覧 -->
  <% if @communities.present? %>
    <div class="row g-4">
      <% @communities.each do |community| %>
        <div class="col-12 col-md-4">
          <div class="card h-100 border-0 shadow-sm rounded-4 p-4 bg-white transition-card">
            <div class="card-body d-flex flex-column justify-content-between p-0">
              <div>
                <div class="mb-2 text-success">
                  <i class="fa-solid fa-seedling"></i>
                </div>
                <h5 class="card-title fw-bold fs-6 mb-2">
                  <%= link_to community.name, community_path(community), class: "text-decoration-none text-dark stretched-link" %>
                </h5>
                <p class="card-text text-muted small mb-0" style="line-height: 1.6;">
                  <%= truncate(community.introduction, length: 50) %>
                </p>
              </div>
              <div class="mt-4 pt-3 border-top text-end">
                <span class="small text-success fw-bold">詳しく見る &rarr;</span>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-5 bg-white rounded-4 shadow-sm text-muted">
      <p class="mb-0">現在、作成されているコミュニティはありません。</p>
    </div>
  <% end %>

</div>