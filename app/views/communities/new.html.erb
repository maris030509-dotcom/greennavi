<div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh">
  <div class="card p-4 shadow-sm " style="width: 800px;" >
    <h4>コミュニティ新規登録</h4>

    <%= form_with model: @community, multipart: true, local: true do |f| %>
      <!-- バリデーションメッセージ-->  
      <% if @community.errors.any? %>
        <div class="error-messages">
          <h4><%= @community.errors.count %>件のエラーがあります</h4>
          <ul>
            <% @community.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- コミュニティ名 -->
      <div class="row mb-3">
        <div class="col-2 d-flex align-items-center">
          <%= f.label :name, "コミュニティ名", class: "form-label mb-0" %>
        </div>
        <div class="col-10">
          <%= f.text_field :name, class: "form-control", placeholder: "コミュニティ名" %>
        </div>
      </div>

      <!-- コミュニティ紹介文 -->
      <div class="row mb-3">
        <div class="col-2 d-flex align-items-center">
          <%= f.label :introduction, "コミュニティ紹介文", class: "form-label mb-0" %>
        </div>
        <div class="col-10">
          <%= f.text_area :introduction, class: "form-control", placeholder: "ここに紹介文を記述します" %>
        </div>
      </div>

      <!-- 登録ボタン -->
      <div class="text-center">
        <%= f.submit "新規登録", class: "btn btn-success px-5 py-2 fw-bold" %>
      </div>
    <% end %>
  </div>
</div>
