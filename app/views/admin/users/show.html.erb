<h4 class="fw-bold mb-4">
  <%= @user.name %>さんの詳細情報
</h4>

<div class="container">
  <div class="row">
    <div class="col-md-8">

      <table class="table table-borderless align-middle">
        <tbody>
          <tr>
            <th class="text-start" style="width: 150px;">ユーザーID</th>
            <td><%= @user.id %></td>
          </tr>
          <tr>
            <th class="text-start">ユーザー名</th>
            <td><%= @user.name %></td>
          </tr>
          <tr>
            <th class="text-start">メールアドレス</th>
            <td><%= @user.email %></td>
          </tr>
          <tr>
            <th class="text-start">都道府県</th>
            <td><%= @user.prefecture.name %></td>
          </tr>
          <tr>
            <th class="text-start">自己紹介文</th>
            <td><%= @user.introduction %></td>
          </tr>
          <tr>
            <th class="text-start">会員ステータス</th>
            <td class="<%= @user.is_active ? 'text-success fw-bold' : 'text-secondary' %>">
              <%= @user.is_active ? "有効" : "退会" %>
            </td>
          </tr>
        </tbody>
      </table>

      <div class="mt-4 d-flex gap-3">
        <%= link_to "編集する",
          edit_admin_user_path(@user),
          class: "btn btn-success text-white px-4 py-2" %>
      </div>
    </div>
  </div>
</div>
