<div class="container mt-5">
  <h4 class="mb-4"><%= @user.name %>さんの会員情報編集</h4>

  <%= form_with model: @user, url: admin_user_path(@user), method: :patch, local: true do |f| %>
    <div class="row mb-3">
      <label class="col-sm-2 col-form-label">ユーザーID</label>
      <div class="col-sm-10 pt-2"><%= @user.id %></div>
    </div>

    <div class="row mb-3">
      <label class="col-sm-2 col-form-label">ユーザー名</label>
      <div class="col-sm-5">
        <%= f.text_field :name,class: "form-control" %>
      </div>
    </div>

    <div class="row mb-3">
      <label class="col-sm-2 col-form-label">メールアドレス</label>
      <div class="col-sm-10"><%= f.email_field :email, class: "form-control" %></div>
    </div>
    
    <div class="row mb-3">
      <label class="col-sm-2 col-form-label">都道府県</label>
      <div class="col-sm-10">
      <%= f.collection_select :prefecture_id, Prefecture.all, :id, :name %>
      </div>
    </div>

    <div class="row mb-3">
      <label class="col-sm-2 col-form-label">自己紹介文</label>
      <div class="col-sm-10">
        <%= f.text_field :body, class: "form-control" %>
      </div>
    </div>

    <div class="row mb-4">
      <label class="col-sm-2 col-form-label">会員ステータス</label>
      <div class="col-sm-10">
        <div class="form-check form-check-inline">
          <%= f.radio_button :is_active, true, class: "form-check-input" %>
          <%= f.label :is_active, "有効", class: "form-check-label" %>
        </div>
        <div class="form-check form-check-inline">
          <%= f.radio_button :is_active, false, class: "form-check-input" %>
          <%= f.label :is_active, "退会", class: "form-check-label" %>
        </div>
      </div>
    </div>

    <div class="text-center">
      <%= f.submit "変更を保存", class: "btn btn-success text-white px-4 py-2" %>
    </div>
  <% end %>
</div>