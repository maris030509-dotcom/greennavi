<div class="container mt-5">
  <div class="card p-4 shadow-sm mx-auto" style="max-width: 800px;">
    <h4 class="fw-bold mb-4">ユーザー一覧</h4>

    <table class="table table-bordered table-hover align-middle text-center w-100">
      <thead class="table-light">
        <tr>
          <th>ユーザーID</th>
          <th>ユーザー名</th>
          <th>メールアドレス</th>
          <th>ステータス</th>
        </tr>
      </thead>

      <tbody>
        <% @users.each_with_index do |user, i| %>
          <tr>
            <td><%= i + 1 %></td>
            <td>
              <%= link_to "#{user.name}", admin_user_path(user),
                class: "text-decoration-none fw-semibold text-primary" %>
            </td>
            <td><%= user.email %></td>
            <td class="<%= user.is_active ? 'text-success fw-bold' : 'text-secondary fw-bold' %>">
              <%= user.is_active ? "有効" : "退会" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>