<div class="container mt-5">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0">
      コミュニティ一覧（全<%= @communities.count %>件）
    </h3>

    <%= link_to "+ コミュニティ作成",
        new_admin_community_path,
        class: "btn btn-success" %>
  </div>

      <!-- コミュニティ一覧 -->
    <table class="table table-bordered table-hover align-middle text-center w-100">
      <thead class="table-light">
        <tr>
          <th>コミュニティ名</th>
          <th class="text-center">コミュニティ紹介文</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @communities.each do |community| %>
          <tr>
            <td>
              <%= link_to community.name, admin_community_path(community) %>
            </td>
            <td class="community-introduction">
              <!--コミュニティ紹介文は60文字まで表示 -->
              <%= truncate(community.introduction, length: 60) %>
            </td>
            <td>
              <% if community.is_active? %>
                <span class="badge bg-success">有効</span>
              <% else %>
                <span class="badge bg-danger">停止中</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
</div>
