<div class="container mt-5">

  <div class="row">

    <!--コミュニティ情報 -->
    <div class="col-md-8">
      <!-- コミュニティ名 -->
      <h4 class="mb-2">🌿<%= @community.name %></h4>
      <!-- コミュニティ有効/停止　状態-->
      <p>
        <% if @community.is_active? %>
          <span class="badge bg-success">有効</span>
        <% else %>
          <span class="badge bg-danger">停止中</span>
        <% end %>
      </p>

      <!-- コミュニティ説明 -->
      <p class="mb-2"><%= @community.introduction %></p>
      
      <!-- 参加者一覧 -->
      <div class="pt-3 border-top">
          <h6 class="text-muted small fw-bold mb-3">
            <i class="fa-solid fa-users me-1 text-success"></i>参加メンバー (<%= @community.community_memberships.count %>人)
          </h6>
          <div class="d-flex flex-wrap gap-2">
            <% @community.users.each do |user| %>
              <% if user.is_active %>
                <%= link_to user.name,
                      admin_user_path(user),
                      class: "badge bg-light text-dark border text-decoration-none px-3 py-2 rounded-pill fw-normal" %>
              <% else %>
                <span class="badge bg-secondary text-white px-3 py-2 rounded-pill fw-normal">
                  退会済みユーザー
                </span>
              <% end %>
            <% end %>
          </div>
        </div>
      <%= link_to "編集する", edit_admin_community_path(@community), class: "btn btn-success btn-sm mt-2" %>

    <!--コメント一覧 -->
      <%= render "admin/community_comments/comments",
          community: @community %>
    </div>
  </div>
</div>