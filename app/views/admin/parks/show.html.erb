<div class="container mt-5">

  <div class="row">

    <!-- 左：公園画像 -->
    <div class="col-md-4">
      <% if @park.park_image.attached? %>
        <%= image_tag @park.park_image, class: "park-image", alt: @park.name %>
      <% else %>
        <%= image_tag "no_image.png", class: "park-image", alt: @park.name %>
      <% end %>
    </div>

    <!-- 右：公園情報 -->
    <div class="col-md-8">
      <!-- 公園名 -->
      <h4 class="mb-2">🌿<%= @park.name %></h4>

      <!-- 都道府県 -->
      <p class="mb-2"><%= @park.prefecture.name %></p>
      
      <!-- 公園紹介文 -->
      <p class="mb-2"><%= @park.introduction %></p>

      <!-- 公園住所 -->
      <p class="mb-2"><%= @park.address %></p>

      <!-- 公園設備 -->
      <p class="mb-2">設備：
        <% @park.equipments.each do |equipment| %>
          <span class="badge bg-success me-1"><%= equipment.name %></span>
        <% end %>
      </p>

      <!-- 公園遊具 -->
      <p class="mb-2">遊具：
        <% @park.playgrounds.each do |playground| %>
          <span class="badge bg-success me-1"><%= playground.name %></span>
        <% end %>
      </p>

      <%= link_to "編集する", edit_admin_park_path(@park), class: "btn btn-success btn-sm mt-2" %>
      <%= button_to "削除する", admin_park_path(@park),
        method: :delete,
        data: { turbo_confirm: "本当に削除しますか？" },
        class: "btn btn-danger btn-sm mt-2" %>

      <!--コメント一覧 -->
      <div class="comments mt-4">
        <h4 class="mb-3">
          コメント (<%= @park.park_comments.count %>)
        </h4>

        <% @park.park_comments.order(created_at: :desc).each do |comment| %>
          <div class="card mb-3 shadow-sm">
            <div class="card-body">

              <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                  <strong>
                    <% if comment.user.is_active %>
                      <%= comment.user.name %>
                    <% else %>
                      <span class="text-muted">退会済みユーザー</span>
                    <% end %>
                  </strong>
                </div>

                <div class="d-flex align-items-center gap-2">
                  <small class="text-muted">
                    <%= l comment.created_at, format: :short %>
                  </small>

                  <% if comment.is_active %>
                    <%= button_to "削除",
                      admin_park_comment_path(@park, comment),
                      method: :delete,
                      data: { turbo_confirm: "このコメントを削除しますか？" },
                      class: "btn btn-outline-danger btn-sm" %>
                  <% end %>
                </div>
              </div>

              <% if comment.is_active %>
                <p class="mb-0">
                  <%= simple_format(comment.body) %>
                </p>
              <% else %>
                <p class="text-muted fst-italic mb-0">
                  このコメントは削除されました
                </p>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
