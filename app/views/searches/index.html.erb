<div class="container py-4">

  <div class="mb-4">
    <h2 class="fw-bold">
      検索結果
    </h2>

    <% if @keyword.present? %>
      <p class="text-muted">
        「<%= @keyword %>」の検索結果：
        <span class="fw-bold"><%= @parks.count %></span>件
      </p>
    <% end %>
  </div>

  <% if @parks.any? %>

    <div class="card shadow-sm">
      <div class="card-body p-0">

        <table class="table table-hover align-middle mb-0">
          <thead class="table-success">
            <tr>
              <th style="width: 150px;">画像</th>
              <th>公園名</th>
              <th>都道府県</th>
              <th>住所</th>
            </tr>
          </thead>

          <tbody>
            <% @parks.each do |park| %>
              <tr>
                <td>
                  <%= link_to park_path(park) do %>
                    <% if park.park_image.attached? %>
                      <%= image_tag park.image,
                          class: "img-thumbnail search-park-image" %>
                    <% else %>
                      <%= image_tag "no_image.png",
                          class: "img-thumbnail search-park-image" %>
                    <% end %>
                  <% end %>
                </td>

                <td>
                  <%= link_to park.name,
                      park_path(park),
                      class: "fw-bold text-decoration-none" %>
                </td>

                <td>
                  <%= park.prefecture.name%>
                </td>

                <td>
                  <%= park.address %>
                </td>
              </tr>
            <% end %>
          </tbody>

        </table>

      </div>
    </div>

  <% else %>

    <div class="card shadow-sm">
      <div class="card-body text-center py-5">

        <h4 class="mb-3">
          検索結果が見つかりませんでした
        </h4>

        <p class="text-muted">
          キーワードを変更して再度検索してください。
        </p>

      </div>
    </div>

  <% end %>

</div>