<div class="hero-section d-flex justify-content-center align-items-center" style="height: 400px; position: relative;">
  <!-- 背景レイヤー -->
  <div class="hero-background"
       style="width: 80%; height: 100%;
              background-image: url(<%= asset_path 'top-image.png' %>);
              background-size: cover;
              background-position: center;
              filter: brightness(0.8);
              border-radius: 12px;">
  </div>

  <!-- テキスト部分 -->
  <div class="hero-content position-absolute text-center"
       style="width: 80%; color: #2e7d32;">
    <h2>みんなでつくる、みんなの公園情報サイト</h2>
    <p>”お気に入りの公園”を見つけよう</p>
  </div>
</div>


<section class="usage-section text-center mt-5">
  <h2>ーサイトの使い方ー</h2>
  <div class="d-flex justify-content-center flex-wrap mt-4">
    <div class="usage-item mx-3">
      <i class="fa-solid fa-magnifying-glass-location fa-2x text-success"></i>
      <h3>公園を検索</h3>
    </div>
    <div class="usage-item mx-3">
      <i class="fa-solid fa-pen-to-square fa-2x text-success"></i>
      <h3>情報を更新</h3>
    </div>
    <div class="usage-item mx-3">
      <i class="fa-solid fa-comments fa-2x text-success"></i>
      <h3>情報を交換</h3>
    </div>
  </div>
</section>

<h2>ー新着の公園ー</h2>

