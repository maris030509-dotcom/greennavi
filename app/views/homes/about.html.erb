<!--ヒーロー画像 -->
<div class="hero-section mb-5">
  <div class="hero-background" style="background-image: url(<%= asset_path 'top-image.png' %>);"></div>
  <div class="hero-content position-absolute text-center">
    <%= image_tag "title.png", alt: "GreenNaviロゴ", class: "hero-logo" %>
    <h4>みんなでつくる、
      <br class="d-md-none">みんなの公園情報サイト
    </h4>
    <h6>”お気に入りの公園”を見つけよう</h6>
  </div>
</div>
<!--サイトの使い方 -->
<div class="container my-5 how-to-container">
  <section class="how-to-section text-center py-4 mb-5">
    <h3 class="mb-4 fw-bold section-title-line">-HOW TO USE-</h3>
    <div class="row justify-content-center g-4">

      <div class="col-12 col-sm-4">
        <div class="how-to-card">
          <div class="card-body">
            <i class="fa-solid fa-magnifying-glass-location how-to-icon"></i>
            <p class="card-text">公園を検索</p>
          </div>
        </div>
      </div>

      <div class="col-12 col-sm-4">
        <div class="how-to-card">
          <div class="card-body">
            <i class="fa-solid fa-photo-film how-to-icon"></i>
            <p class="card-text">写真や設備をチェック</p>
          </div>
        </div>
      </div>

      <div class="col-12 col-sm-4">
        <div class="how-to-card">
          <div class="card-body">
            <i class="fa-solid fa-comments how-to-icon"></i>
            <p class="card-text">コミュニティで情報交換</p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!--新着公園一覧　4つまで表示 -->
  <div class="d-flex justify-content-center align-items-center mb-4">
    <h3 class="mb-0 fw-bold section-title-line">
      🌿-NEW-🌿
    </h3>
    <div class="ms-3">
      <%= link_to "すべて見る", parks_path, class: "btn btn-outline-success btn-sm rounded-pill px-3" %>
    </div>
  </div>

  <div class="row g-4 justify-content-center mb-5">
    <% @parks.first(4).each do |park| %>
      <div class="col-12 col-sm-6 col-lg-3">
        <div class="park-card">
          <%= link_to park_path(park) do %>
            <% if park.park_image.attached? %>
              <%= image_tag park.park_image,
                class: "park-card-image",
                alt: park.name %>
            <% else %>
              <div class="park-card-no-image">
                <i class="fa-regular fa-image"></i>
                <span>No Image</span>
              </div>
            <% end %>
          <% end %>
          <div class="park-card-body">
            <h5 class="park-card-title">
              <%= park.name %>
            </h5>
            <p class="park-card-details">
              <%= park.prefecture&.name %>
            </p>
            <p class="park-card-details">
              <%= park.address %>
            </p>
          </div>
        </div>
      </div>
    <% end %>
  </div>

</div>