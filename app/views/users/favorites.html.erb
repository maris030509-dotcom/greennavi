<div class="mt-4">
    <h5>お気に入りの公園</h5>
    <% if @favorite_parks.present? %>
      <table class="table table-bordered table-hover">
        <thead>
          <tr>
            <th>公園</th>
            <th>住所</th>
            <th></th>
          </tr>
        </thead>

        <tbody>
          <% @favorite_parks.each do |park| %>
            <tr>
              <td>
                <!--公園写真 -->
                <%= link_to park_path(park) do %>
                  <div class="text-center">
                    <% if park.park_image.attached? %>
                      <%= image_tag park.park_image, 
                        class: "card-img-top", 
                        style: "width:80px; height:80px;",
                        alt: park.name %>
                    <% else %>
                      <%= image_tag "no_image.png", 
                      class: "card-img-top", 
                      style: "width:80px; height:80px;", 
                      alt: park.name %>
                    <% end %>
                    <!--公園名 -->
                    <div><%= park.name %></div>
                  </div>
               <% end %>
              </td>
              <!--都道府県/住所 -->
              <td><%= park.prefecture.name %><%= park.address %></td>
              <td>
                <%= button_to "♥解除",
                  park_favorite_path(park),
                  method: :delete,
                  class: "btn btn-outline-danger btn-sm" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="text-center py-5">
        <p class="text-muted mb-0">
          まだお気に入りはありません
        </p>
      </div>
    <% end %>
  </div>
