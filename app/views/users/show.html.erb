<div class="container mt-5">
  <h2 class="mb-4"><%= @user.name%>さんの詳細情報</h2>

  <table class="table table-bordered">
    <tr>
      <th>ユーザー名</th>
      <td><%= @user.name %></td>
    </tr>
    <tr>
      <th>都道府県</th>
      <td><%= @user.prefecture.name %></td>
    </tr>
    <tr>
      <th>自己紹介文</th>
      <td><%= @user.introduction %></td>
    </tr>
  </table>

  <%= link_to "♥ #{@user.name}さんのお気に入りの公園を見る",
    favorites_user_path(@user),
    class: "btn btn-outline-success" %>

  <div class="mt-4">
    <h5><%= @user.name%>さんの投稿一覧</h5>
    <% if @parks.present? %>
      <table class="table table-bordered table-hover">
        <thead>
          <tr>
            <th>公園名</th>
            <th>住所</th>
            <th>登録日</th>
          </tr>
        </thead>

        <tbody>
          <% @parks.each do |park| %>
            <tr>
              <td>
                <!--公園写真 -->
                <%= link_to park_path(park) do %>
                  <div class="text-center">
                    <% if park.park_image.attached? %>
                      <%= image_tag park.park_image, 
                        class: "card-img-top", 
                        style: "width:80px; height:80px;",
                        alt: park.name %>
                    <% else %>
                      <%= image_tag "no_image.png", 
                      class: "card-img-top", 
                      style: "width:80px; height:80px;", 
                      alt: park.name %>
                    <% end %>
                    <!--公園名 -->
                    <div><%= park.name %></div>
                  </div>
               <% end %>
              </td>
              <!--都道府県/住所 -->
              <td><%= park.prefecture.name %><%= park.address %></td>
              <td><%= park.created_at.to_date %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="text-center py-5">
        <p class="text-muted mb-0">
          まだ投稿はありません
        </p>
      </div>
    <% end %>

  </div>
</div>