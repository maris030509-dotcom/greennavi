<div class="container mt-5">
  <h2 class="mb-4">マイページ</h2>

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h4>登録情報</h4>
    <%= link_to "編集する", information_edit_users_path, class: "btn btn-success" %>
  </div>

  <table class="table table-bordered">
    <tr>
      <th>ユーザー名</th>
      <td><%= @user.name %></td>
    </tr>
    <tr>
      <th>メールアドレス</th>
      <td><%= @user.email %></td>
    </tr>
    <tr>
      <th>都道府県</th>
      <td><%= @user.prefecture.name %></td>
    </tr>
    <tr>
      <th>自己紹介文</th>
      <td><%= @user.introduction %></td>
    </tr>
  </table>

  <div class="mt-4">
    <h5>投稿一覧</h5>
  </div>
</div>