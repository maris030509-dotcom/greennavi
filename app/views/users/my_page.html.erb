<div class="container mt-5">
  <h2 class="mb-4">マイページ</h2>

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h4>登録情報</h4>
    <%= link_to "編集する", information_edit_users_path, class: "btn btn-success" %>
  </div>

  <table class="table table-bordered">
    <tr>
      <th>ユーザー名</th>
      <td><%= @user.name %></td>
    </tr>
    <tr>
      <th>メールアドレス</th>
      <td><%= @user.email %></td>
    </tr>
    <tr>
      <th>都道府県</th>
      <td><%= @user.prefecture.name %></td>
    </tr>
    <tr>
      <th>自己紹介文</th>
      <td><%= @user.introduction %></td>
    </tr>
  </table>

  <div class="mt-4">
    <h5>投稿一覧</h5>
    <table class="table table-bordered table-hover">
      <thead>
        <tr>
          <th>公園名</th>
          <th>住所</th>
          <th>登録日</th>
        </tr>
      </thead>
      
      <tbody>
        <% @parks.each do |park| %>
          <tr>
            <td>
              <%= link_to park_path(park) do %>
                <div class="text-center">
                  <% if park.park_image.attached? %>
                    <%= image_tag park.park_image, 
                      class: "card-img-top", 
                      style: "width:80px; height:80px;",
                      alt: park.name %>
                  <% else %>
                    <%= image_tag "no_image.png", 
                    class: "card-img-top", 
                    style: "width:80px; height:80px;", 
                    alt: park.name %>
                  <% end %>

                  <div><%= park.name %></div>
                </div>
              <% end %>
            </td>
            <td><%= park.prefecture.name %><%= park.address %></td>
            <td><%= park.created_at.to_date %></td>
          </tr>
        <% end %>
      <tbody>
    </table>
  </div>
</div>