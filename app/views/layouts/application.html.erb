<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Greennavi" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://kit.fontawesome.com/eba0b4fb76.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  
    <!--　GoogleFont　Kosugi Maru -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kosugi+Maru&display=swap" rel="stylesheet">
  
  </head>

  <!-- ヘッダー-->
  <header>
    <nav class="navbar navbar-expand-lg main-navbar border-bottom">
      <div class="container">
        <!-- ロゴ -->
        <%= link_to root_path, class: "navbar-brand" do %>
          <%= image_tag "logo.png",
              alt: "LOGO",
              class: "header-logo" %>
        <% end %>

        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarNav">

          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">

          <div class="ms-auto">

            <% if user_signed_in? %>

              <ul class="navbar-nav align-items-lg-center">

                <li class="nav-item">
                  <%= link_to "マイページ",
                      my_page_users_path,
                      class: "nav-link header-button" %>
                </li>

                <li class="nav-item">
                  <%= link_to "公園一覧",
                      parks_path,
                      class: "nav-link header-button" %>
                </li>

                <li class="nav-item">
                  <%= link_to "コミュニティ一覧",
                      communities_path,
                      class: "nav-link header-button" %>
                </li>

                <li class="nav-item">
                  <%= link_to "ログアウト",
                      destroy_user_session_path,
                      data: { turbo_method: :delete },
                      class: "nav-link header-button" %>
                </li>

              </ul>

            <% else %>

              <ul class="navbar-nav">

                <li class="nav-item">
                  <%= link_to "公園一覧",
                      parks_path,
                      class: "nav-link header-button" %>
                </li>

                <li class="nav-item">
                  <%= link_to "コミュニティ一覧",
                      communities_path,
                      class: "nav-link header-button" %>
                </li>

                <li class="nav-item">
                  <%= link_to "新規登録",
                      new_user_registration_path,
                      class: "nav-link header-button" %>
                </li>

                <li class="nav-item">
                  <%= link_to "ログイン",
                      new_user_session_path,
                      class: "nav-link header-button" %>
                </li>

              </ul>

            <% end %>
            <!--検索機能　公園名もしくは都道府県で絞り込み -->
            <%= form_with url: search_path,
                method: :get,
                local: true,
                class: "d-flex mt-3 mt-lg-0 ms-lg-3" do |f| %>

              <%= f.text_field :keyword,
                  value: params[:keyword],
                  placeholder: "公園名/都道府県名を入力",
                  class: "form-control me-2" %>

              <%= f.submit "検索",
                  class: "btn btn-success" %>

            <% end %>

          </div>

        </div>

      </div>
    </nav>
  </header>

  <body>
    <% flash.each do |key, value| %>
      <div class= "alert alert-<%= key == "notice" ? "success" : "danger" %>">
        <%= value %>
      </div>
    <% end %>

    <%= yield %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
  </body>
</html>
