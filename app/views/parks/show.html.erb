<!--コメント投稿のバリエーションメッセージ -->
<% if @park_comment.errors.any? %>
  <div class="alert alert-danger">
    <ul class="mb-0">
      <% @park_comment.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="container mt-5">

  <div class="row">

    <!-- 左：公園画像 -->
    <div class="col-md-4">
      <% if @park.park_image.attached? %>
        <%= image_tag @park.park_image, class: "park-image", alt: @park.name %>
      <% else %>
        <%= image_tag "no_image.png", class: "park-image", alt: @park.name %>
      <% end %>
    </div>

    <!-- 右：公園情報 -->
    <div class="col-md-8">
      <!-- 公園名 -->
      <h4 class="mb-2">🌿<%= @park.name %></h4>

      <!-- 都道府県 -->
      <p class="mb-2"><%= @park.prefecture.name %></p>
      
      <!-- 公園住所 -->
      <p class="mb-2"><%= @park.address %></p>

      <!-- 公園紹介文 -->
      <p class="mb-2"><%= @park.introduction %></p>
      
      <!-- 公園設備 -->
      <p class="mb-2">設備：
        <% @park.equipments.each do |equipment| %>
          <span class="badge bg-success me-1"><%= equipment.name %></span>
        <% end %>
      </p>

      <!-- 公園遊具 -->
      <p class="mb-2">遊具：
        <% @park.playgrounds.each do |playground| %>
          <span class="badge bg-success me-1"><%= playground.name %></span>
        <% end %>
      </p>

      <span class="me-2">
        ♥ <%= @park.favorites.count %>
      </span>
      <!--ログインしている人だけ操作可能 -->
      <% if user_signed_in? %>
        <!--いいねボタン -->
        <div class="mt-2">
          <% if @park.favorited_by?(current_user) %>
            <%= button_to "♥ お気に入り解除",
                park_favorite_path(@park),
                method: :delete,
                class: "btn btn-danger btn-sm mt-2" %>
          <% else %>
            <%= button_to "♡ お気に入り登録",
                park_favorite_path(@park),
                method: :post,
                class: "btn btn-outline-danger btn-sm mt-2" %>
          <% end %>
        </div>
        <!--編集ボタン -->
        <%= link_to "編集する", edit_park_path(@park),
          class: "btn btn-success btn-sm mt-2" %>
      <% end %>
      <!--GoogleMap表示 -->
      <div id="map"
          data-lat="<%= @park.latitude %>"
          data-lng="<%= @park.longitude %>"
          style="height: 300px; width: 75%;">
      </div>
      <%= link_to "Googleマップで開く",
        "https://www.google.com/maps/search/?api=1&query=#{@park.latitude},#{@park.longitude}",
        target: :_blank,
        class: "btn btn-outline-success" %>

      <!--コメント一覧 -->
      <%= render "park_comments/comments",
          park: @park %>
      <!--コメント投稿 -->
      <%= render "park_comments/form",
          park: @park,
          park_comment: @park_comment %>

    </div>
  </div>
</div>

