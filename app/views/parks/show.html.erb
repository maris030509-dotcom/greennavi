<div class="container mt-5">

  <div class="row">

    <!-- 左：公園画像 -->
    <div class="col-md-4">
      <%= image_tag @park.image, class: "item-detail-img" %>
    </div>

    <!-- 右：公園情報 -->
    <div class="col-md-8">
      <!-- 公園名 -->
      <h4 class="mb-2"><%= @park.name %></h4>

      <!-- 都道府県 -->
      <p class="mb-2"><%= @park.prefecture %></p>
      
      <!-- 公園紹介文 -->
      <p class="mb-2"><%= @park.introduction %></p>

      <!-- 公園住所 -->
      <p class="mb-2"><%= @park.address %></p>

      <!-- 公園設備 -->
      <p class="mb-2">
        <% @park.equipments.each do |equipment| %>
          <span class="badge bg-success me-1"><%= equipment.name %></span>
        <% end %>
      </p>

      <!-- 公園遊具 -->
      <p class="mb-2">
        <% @park.playgrounds.each do |playground| %>
          <span class="badge bg-success me-1"><%= playground.name %></span>
        <% end %>
      </p>

    </div>

  </div>

</div>
