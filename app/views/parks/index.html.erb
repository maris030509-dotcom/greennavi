<div class="container my-5" style="max-width: 1000px;">
  <div class="d-flex justify-content-between align-items-center flex-wrap mb-5">
    <h2 class="fw-bold fs-3 mb-0 section-title-line" style="color: #3B5339;">
      🌿 公園一覧 <span class="fs-6 text-muted fw-normal">（全<%= @parks.count %>件）</span>
    </h2>
    <%= link_to "+ 新規公園投稿", new_park_path, class: "btn btn-success rounded-pill px-4 shadow-sm" %>
  </div>

  <% if @parks.present? %>
    <div class="row g-4 justify-content-start mb-5">
      <% @parks.each do |park| %>
        <div class="col-12 col-sm-6 col-lg-3">
          <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            
            <!-- 画像部分 -->
            <%= link_to park_path(park) do %>
              <% if park.park_image.attached? %>
                <%= image_tag park.park_image, class: "card-img-top object-fit-cover", height: "180", alt: park.name %>
              <% else %>
                <div class="no-image-wrapper d-flex flex-column align-items-center justify-content-center text-muted" style="height: 180px; background-color: #EFECE6;">
                  <i class="fa-regular fa-image fa-2x mb-2 opacity-50"></i>
                  <span class="small">No Image</span>
                </div>
              <% end %>
            <% end %>

            <!-- カード本文 -->
            <div class="card-body text-center p-3 d-flex flex-column justify-content-between">
              <div>
                <h5 class="card-title fw-bold fs-6 mb-2" style="color: #2C3E35;">
                  <%= link_to park.name, park_path(park), class: "text-decoration-none text-dark" %>
                </h5>
                <p class="card-text text-muted small mb-1"><%= park.prefecture&.name %></p>
                <p class="card-text text-muted small mb-3" style="font-size: 0.8rem;"><%= park.address %></p>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-5 bg-white rounded-4 shadow-sm text-muted">
      <p class="mb-0">登録されている公園はありません。</p>
    </div>
  <% end %>
</div>
